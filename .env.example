# =============================================================================
# Variaveis de ambiente PLANEJADAS do YouTube Niche Miner.
#
# Este arquivo contem apenas NOMES e placeholders. Nunca coloque valores reais
# aqui. Copie para `.env.local` (ignorado pelo git) e preencha localmente.
#
# Regra: tudo que comeca com NEXT_PUBLIC_ e enviado ao navegador. Nenhuma chave
# de API, service role ou segredo pode usar esse prefixo. Ver ADR-004.
#
# Nenhuma dessas variaveis e usada ainda: as integracoes reais serao ativadas
# nas SPECs seguintes. O schema vive em src/config/env.ts.
# =============================================================================

# --- Aplicacao ---------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000

# --- Supabase (SPEC-004) -----------------------------------------------------
# Publicas: podem ir para o navegador. Protegidas por Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=chave-anon-publica

# SEGREDO — apenas no servidor. IGNORA Row Level Security por completo.
# Lida somente por src/config/env.ts, que lanca se importado no navegador, e
# usada apenas por src/shared/infrastructure/supabase/, que carrega
# `import 'server-only'` — o build falha se um componente de cliente a alcancar.
SUPABASE_SERVICE_ROLE_KEY=troque-por-segredo-do-servidor

# Para desenvolvimento local com `npm run db:start`, o Supabase CLI imprime a
# URL e as chaves do projeto local. Nunca aponte para um projeto remoto durante
# testes automatizados.

# --- YouTube Data API v3 (SPEC futura) ---------------------------------------
# SEGREDO — apenas no servidor.
YOUTUBE_API_KEY=troque-por-segredo-do-servidor
# Teto diario de unidades de quota que a aplicacao pode gastar.
YOUTUBE_DAILY_QUOTA_LIMIT=10000

# --- Claude API (SPEC futura) ------------------------------------------------
# SEGREDO — apenas no servidor.
ANTHROPIC_API_KEY=troque-por-segredo-do-servidor
ANTHROPIC_MODEL=claude-sonnet-5
# Teto de tokens de saida por relatorio, para controle de custo.
AI_MAX_OUTPUT_TOKENS=4000

# --- Politica de reuso de analise --------------------------------------------
# Por quantas horas uma analise concluida pode ser reaproveitada antes de
# disparar nova coleta. Ver regra de negocio RN-10 em SPEC-001.
ANALYSIS_FRESHNESS_HOURS=24
